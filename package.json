{
  "name": "ariadne-extension-vscode",
  "displayName": "ariadne",
  "publisher": "ariadne",
  "description": "A student-first VS Code tool that reviews code for security flaws without compromising academic integrity.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java",
    "onLanguage:ariadne",
    "workspaceContains:rules/main.ariadne",
    "onCommand:ariadne-extension-vscode.analyze",
    "onView:ariadne.panel.activeVulnerabilities",
    "onView:ariadne.panel.sessionMetrics",
    "onView:ariadne.sidebar.signIn"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ariadne",
        "aliases": [
          "Ariadne",
          "ariadne"
        ],
        "extensions": [
          ".ariadne"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ariadne",
        "scopeName": "source.ariadne",
        "path": "./syntaxes/ariadne.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ariadne-extension-vscode.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "ariadne-extension-vscode.openFeedbackPanel",
        "title": "Ariadne: Ask Ariadne"
      },
      {
        "command": "ariadne-extension-vscode.analyze",
        "title": "Ariadne: Analyze"
      },
      {
        "command": "ariadne-extension-vscode.openSignInPanel",
        "title": "Ariadne: Sign In to GitHub"
      },
      {
        "command": "ariadne-extension-vscode.openTermsOfUse",
        "title": "Ariadne: Terms of Use"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ariadne-sidebar",
          "title": "Ariadne",
          "icon": "media/shield.svg"
        }
      ],
      "panel": [
        {
          "id": "ariadne-panel",
          "title": "Ariadne",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "ariadne-sidebar": [
        {
          "type": "webview",
          "id": "ariadne.sidebar.signIn",
          "name": "Account",
          "icon": "$(account)"
        }
      ],
      "ariadne-panel": [
        {
          "type": "webview",
          "id": "ariadne.panel.activeVulnerabilities",
          "name": "ARIADNE (ACTIVE VULNERABILITIES)",
          "group": "left",
          "icon": "$(shield)"
        },
        {
          "type": "webview",
          "id": "ariadne.panel.sessionMetrics",
          "name": "SESSION METRICS",
          "group": "right",
          "icon": "$(graph)"
        }
      ]
    },
    "configuration": {
      "title": "Ariadne",
      "properties": {
        "ariadne.copilot.model": {
          "type": "string",
          "default": "gemini-3.5-flash",
          "enum": [
            "gpt-5-mini",
            "claude-haiku-4.5",
            "gemini-3.5-flash",
            "gpt-5.4-mini",
            "gpt-5.5"
          ],
          "markdownDescription": "GitHub Copilot model for vulnerability explanations. Lightweight models (gpt-5-mini, claude-haiku-4.5, gemini-3.5-flash) are fastest for plain-English feedback."
        },
        "ariadne.executable": {
          "type": "string",
          "default": "ariadne",
          "markdownDescription": "Path to the `ariadne` binary. Leave as `ariadne` to use PATH, or a cargo `target/debug/ariadne` build in the open workspace."
        }
      }
    },
    "configurationDefaults": {
      "github.copilot.editor.enableCodeActions": false,
      "errorLens.excludeBySource": [
        "ariadne"
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.7"
  }
}
