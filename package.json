{
  "name": "ariadne-extension-vscode",
  "displayName": "ariadne",
  "description": "A student-first VS Code tool that reviews code for security flaws without compromising academic integrity.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java",
    "onCommand:ariadne-extension-vscode.analyze",
    "onView:ariadne.panel.activeVulnerabilities",
    "onView:ariadne.panel.sessionMetrics",
    "onView:ariadne.panel.signIn"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ariadne-extension-vscode.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "ariadne-extension-vscode.openFeedbackPanel",
        "title": "Ariadne: Ask Ariadne"
      },
      {
        "command": "ariadne-extension-vscode.analyze",
        "title": "Ariadne: Analyze"
      },
      {
        "command": "ariadne-extension-vscode.openSignInPanel",
        "title": "Ariadne: Sign In to GitHub"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "ariadne-panel",
          "title": "Ariadne",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "ariadne-panel": [
        {
          "type": "webview",
          "id": "ariadne.panel.activeVulnerabilities",
          "name": "ARIADNE (ACTIVE VULNERABILITIES)",
          "group": "left",
          "icon": "$(shield)"
        },
        {
          "type": "webview",
          "id": "ariadne.panel.sessionMetrics",
          "name": "SESSION METRICS",
          "group": "right",
          "icon": "$(graph)"
        },
        {
          "type": "webview",
          "id": "ariadne.panel.signIn",
          "name": "GITHUB SIGN-IN",
          "group": "right",
          "icon": "$(account)"
        }
      ]
    },
    "configuration": {
      "title": "Ariadne",
      "properties": {
        "ariadne.copilot.model": {
          "type": "string",
          "default": "gpt-5.5",
          "enum": [
            "gpt-5.5",
            "gpt-4o-mini",
            "gpt-4o",
            "gpt-4.1-mini",
            "gpt-4.1-nano"
          ],
          "markdownDescription": "GitHub Copilot model to use for generating vulnerability explanations."
        }
      }
    },
    "configurationDefaults": {
      "github.copilot.editor.enableCodeActions": false,
      "errorLens.excludeBySource": [
        "ariadne"
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.107.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.7"
  }
}
