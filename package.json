{
  "name": "ariadne-extension-vscode",
  "displayName": "Ariadne for VSCode",
  "icon": "media/ariadne.png",
  "publisher": "tallbreadstick",
  "description": "A student-first VS Code tool that reviews code for security flaws without compromising academic integrity.",
  "version": "0.1.3",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/tallbreadstick/ariadne-extension-vscode.git"
  },
  "homepage": "https://github.com/tallbreadstick/ariadne-extension-vscode",
  "bugs": {
    "url": "https://github.com/tallbreadstick/ariadne-extension-vscode/issues"
  },
  "qna": "false",
  "keywords": [
    "security",
    "education",
    "java"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:java",
    "onLanguage:ariadne",
    "workspaceContains:rules/main.ariadne",
    "onCommand:ariadne-extension-vscode.openOnboarding",
    "onCommand:ariadne-extension-vscode.openDebugLogFolder",
    "onCommand:ariadne-extension-vscode.debugResetOnboarding",
    "onView:ariadne.panel.gateway",
    "onView:ariadne.panel.activeVulnerabilities",
    "onView:ariadne.panel.sessionMetrics",
    "onView:ariadne.sidebar.signIn"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ariadne",
        "aliases": [
          "Ariadne",
          "ariadne"
        ],
        "extensions": [
          ".ariadne"
        ],
        "filenamePatterns": [
          "*.ariadne"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ariadne",
        "scopeName": "source.ariadne",
        "path": "./syntaxes/ariadne.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ariadne-extension-vscode.openFeedbackPanel",
        "title": "Ariadne: Explain Vulnerability"
      },
      {
        "command": "ariadne-extension-vscode.openSignInPanel",
        "title": "Ariadne: Sign In to GitHub"
      },
      {
        "command": "ariadne-extension-vscode.openPanel",
        "title": "Ariadne: Open Panel"
      },
      {
        "command": "ariadne-extension-vscode.toggleTreeView",
        "title": "Ariadne: Show Data Audit",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "ariadne-extension-vscode.showFindingInAudit",
        "title": "Ariadne: Open in Audit Graph"
      },
      {
        "command": "ariadne-extension-vscode.openSettings",
        "title": "Ariadne: Settings"
      },
      {
        "command": "ariadne-extension-vscode.openOnboarding",
        "title": "Ariadne: Open Onboarding Guide"
      },
      {
        "command": "ariadne-extension-vscode.openTermsOfUse",
        "title": "Ariadne: Terms of Use"
      },
      {
        "command": "ariadne-extension-vscode.openPrivacyPolicy",
        "title": "Ariadne: Privacy Policy"
      },
      {
        "command": "ariadne-extension-vscode.openDebugLogFolder",
        "title": "Ariadne: Open Debug Log Folder"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ariadne-sidebar",
          "title": "Ariadne",
          "icon": "media/shield.svg"
        }
      ],
      "panel": [
        {
          "id": "ariadne-panel",
          "title": "Ariadne",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "ariadne-sidebar": [
        {
          "type": "webview",
          "id": "ariadne.sidebar.signIn",
          "name": "Ariadne"
        }
      ],
      "ariadne-panel": [
        {
          "type": "webview",
          "id": "ariadne.panel.gateway",
          "name": "ARIADNE",
          "icon": "$(shield)",
          "when": "!ariadne.panelReady"
        },
        {
          "type": "webview",
          "id": "ariadne.panel.activeVulnerabilities",
          "name": "ACTIVE VULNERABILITIES",
          "group": "left",
          "icon": "$(shield)",
          "when": "ariadne.panelReady"
        },
        {
          "type": "webview",
          "id": "ariadne.panel.sessionMetrics",
          "name": "SESSION METRICS",
          "group": "right",
          "icon": "$(graph)",
          "when": "ariadne.panelReady"
        }
      ]
    },
    "configuration": {
      "title": "Ariadne",
      "properties": {
        "ariadne.executable": {
          "type": "string",
          "default": "ariadne",
          "markdownDescription": "Optional path to a local `ariadne` binary. Leave as `ariadne` to use the binary selected in the sidebar Core section."
        },
        "ariadne.notifications.level": {
          "type": "string",
          "default": "milestones",
          "enum": [
            "milestones",
            "all",
            "quiet"
          ],
          "enumDescriptions": [
            "Only show notifications for meaningful lifecycle milestones (new candidates, fixes applied, initial persisting status, recurrences, resolutions).",
            "Show all notifications, including repeating reminders for steady-state persisting issues.",
            "Suppress all popup toast notifications. Metrics and issues remain visible in the bottom panel, editor highlights, and status bar."
          ],
          "markdownDescription": "Controls the verbosity of Ariadne popup toast notifications."
        },
        "ariadne.autoScan.intervalMinutes": {
          "type": "integer",
          "default": 60,
          "minimum": 2,
          "maximum": 180,
          "markdownDescription": "Duration in minutes between automatic full background scans (default: 60 minutes). Minimum: 2 minutes, Maximum: 180 minutes."
        },
        "ariadne.metricsIngest.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Send anonymized session metrics to the Ariadne collection server when signed in with analytics consent."
        },
        "ariadne.metricsIngest.baseUrl": {
          "type": "string",
          "default": "https://127.0.0.1:8443",
          "markdownDescription": "HTTPS base URL of the metrics ingest server (no trailing slash). Change this when deploying the collection server."
        },
        "ariadne.metricsIngest.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Bearer token for metrics ingest (`Authorization` header). Must be at least 32 characters. Leave empty to use the value stored in Secret Storage under `ariadne.metricsIngestApiKey`."
        },
        "ariadne.metricsIngest.trustLocalTls": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Allow self-signed TLS certificates when connecting to `127.0.0.1` or `localhost` collection servers."
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "*.ariadne": "ariadne"
      },
      "github.copilot.editor.enableCodeActions": false,
      "errorLens.excludeBySource": [
        "ariadne"
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "vsix": "npm run vscode:prepublish && vsce package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p tsconfig.test.json --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "workflow": "node scripts/workflow.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.7"
  }
}