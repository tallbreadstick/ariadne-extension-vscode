bin/**
.vscode/**
.vscode-test/**
.vscode-test.mjs
out/**
src/**
.gitignore
.gitattributes
.env
.env.*
.yarnrc
esbuild.js
eslint.config.mjs
vsc-extension-quickstart.md
package-lock.json
*.vsix
**/*.vsix
**/tsconfig.json
**/tsconfig.*.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*
**/*.log
.DS_Store

# Agentic scaffolding and docs. README.md stays; the Marketplace page is that file.
*.md
!README.md
!CHANGELOG.md
docs/**
iterations/**

# Tool-specific agent configs
.codex/**
.cursor/**
.impeccable/**
.github/**

# Dev scripts and fixtures
scripts/**
sample-project/**
test-project/**
test-project - Copy/**

# Dependencies. The extension bundle is dist/extension.js. What remains
# below is the Copilot SDK, which esbuild leaves external, plus the
# native CLI for Linux x64, Windows x64, and Windows ARM64.
# linuxmusl, darwin, and linux arm64 stay out: the resolver falls through
# to them, and shipping them would add another full CLI.
node_modules/**

!node_modules/@github/copilot/**
!node_modules/@github/copilot-sdk/**
!node_modules/@github/copilot-linux-x64/**
!node_modules/@github/copilot-win32-x64/**
!node_modules/@github/copilot-win32-arm64/**
!node_modules/koffi/**
!node_modules/vscode-jsonrpc/**
!node_modules/zod/**
!node_modules/@koromix/koffi-linux-x64/**
!node_modules/@koromix/koffi-win32-x64/**
!node_modules/@koromix/koffi-win32-arm64/**

node_modules/@github/copilot-linuxmusl-*/**
node_modules/@github/copilot-linux-arm64/**
node_modules/@github/copilot-darwin*/**
node_modules/@github/copilot-win32-ia32/**

# Docs, licenses, and native sources inside the packages we do ship.
node_modules/**/*.md
node_modules/**/LICENSE*
node_modules/**/CHANGELOG*
node_modules/koffi/src/**
node_modules/koffi/vendor/**
node_modules/koffi/doc/**
node_modules/@github/copilot-sdk/docs/**
node_modules/@github/copilot-*/webview/**/docs/**

# Each Copilot package vendors every OS clipboard binary. Keep its own slice.
node_modules/@github/copilot-linux-x64/**/clipboard.darwin-*
node_modules/@github/copilot-linux-x64/**/clipboard.win32-*
node_modules/@github/copilot-linux-x64/**/clipboard.linux-arm64-*
node_modules/@github/copilot-win32-x64/**/clipboard.darwin-*
node_modules/@github/copilot-win32-x64/**/clipboard.linux-*
node_modules/@github/copilot-win32-x64/**/clipboard.win32-arm64-*
node_modules/@github/copilot-win32-arm64/**/clipboard.darwin-*
node_modules/@github/copilot-win32-arm64/**/clipboard.linux-*
node_modules/@github/copilot-win32-arm64/**/clipboard.win32-x64-*

# Zod's published CJS entry loads v4 only.
node_modules/zod/src/**
node_modules/zod/v3/**
node_modules/zod/mini/**
node_modules/zod/v4-mini/**
node_modules/zod/locales/**
