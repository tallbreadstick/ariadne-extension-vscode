# Dependencies. Bundle is dist/extension.js; Copilot native CLIs download at runtime.
node_modules/**

!node_modules/@github/copilot/**
!node_modules/@github/copilot-sdk/**
!node_modules/koffi/**
!node_modules/vscode-jsonrpc/**
!node_modules/zod/**
